#
# modules.config -- fixture for test_modules and the module template run in
# run_tests.sh
#
# bjornwennberg71@gmail.com
#
# A rack of identical battery modules, written once as templates
# (slave = module), plus a string controller at a fixed slave between them.
# The file says 2 modules from slave 1; the tests override that with
# -e module.count=4 -e module.slave_first=39, which is how a site sets it.
#
# Expanded (module-major), 4 modules from 39:
#
#   1: input.1 module 0 slave 39    2: input.2 slave 100 (fixed)
#   3: input.3 module 0 slave 39    4: input.1 module 1 slave 40
#   5: input.3 module 1 slave 40    ...    9: input.3 module 3 slave 42
#

config.name    = modules
config.version = 2.0

modbusmq.connect       = tcp://localhost:15502
modbusmq.frame_timeout = 500

module.count       = 2
module.slave_first = 1

input.max            = 3
input.query_mode     = rounds
input.round_interval = 200

# module totals, every round
input.1.slave       = module
input.1.type        = input_register
input.1.address     = 0x0000
input.1.naddress    = 2
input.1.tier        = fast
input.1.channel.max = 2
input.1.channel.1.offset = 0
input.1.channel.1.format = uint_ab
input.1.channel.1.mod    = -100
input.1.channel.1.topic  = battery/%i/voltage
input.1.channel.1.value  = 5120
input.1.channel.2.offset = 2
input.1.channel.2.format = uint_ab
input.1.channel.2.topic  = battery/%i/soc
input.1.channel.2.value  = 87

# the string controller, at its own fixed slave
input.2.slave       = 100
input.2.type        = input_register
input.2.address     = 0x0000
input.2.naddress    = 1
input.2.tier        = fast
input.2.channel.max = 1
input.2.channel.1.offset = 0
input.2.channel.1.format = uint_ab
input.2.channel.1.mod    = -100
input.2.channel.1.topic  = string/voltage
input.2.channel.1.value  = 40960

# cell voltage, when the round visits this module
input.3.slave       = module
input.3.type        = input_register
input.3.address     = 0x0100
input.3.naddress    = 1
input.3.tier        = deep
input.3.channel.max = 1
input.3.channel.1.offset = 0
input.3.channel.1.format = uint_ab
input.3.channel.1.mod    = -1000
input.3.channel.1.topic  = battery/%i/cell/1/voltage
input.3.channel.1.value  = 3301

# charge current limit, one per module
write.max = 1
write.1.name    = charge_limit
write.1.slave   = module
write.1.type    = holding_register
write.1.address = 0x0300
write.1.format  = uint_ab
write.1.mod     = -10
write.1.ack     = 1
write.1.topic   = battery/%i/set/charge_limit

#
# Fixture config for the test suite.
#
# Every channel carries a "value =" default, which modbusmq_server serves as a
# raw register value and the tests read back through the full scaling path. The
# expected results are asserted in test_read.c -- change a value here and that
# test must change with it.
#
# Port 15502 rather than the usual 1502, so a test run does not collide with a
# virtual server someone left running.
#

config.name    = modbusmq test fixture
config.version = 2.0

modbusmq.connect       = tcp://localhost:15502
modbusmq.frame_timeout = 2000
modbusmq.rts_delay     = 0

input.max        = 5
input.query_mode = 0

#
# 1. input registers, exercising every decoder and every scaling term
#
input.1.slave       = 1
input.1.type        = input_register
input.1.address     = 0x0000
input.1.naddress    = 12
input.1.interval    = 200
input.1.channel.max = 6

# raw 4800, mod -100 -> 48.00
input.1.channel.1.offset = 0x00
input.1.channel.1.format = uint_ab
input.1.channel.1.mod    = -100
input.1.channel.1.topic  = t/voltage
input.1.channel.1.value  = 4800

# raw -50 signed, mod -10 -> -5.0
input.1.channel.2.offset = 0x02
input.1.channel.2.format = int_ab
input.1.channel.2.mod    = -10
input.1.channel.2.topic  = t/current
input.1.channel.2.value  = -50

# 4-byte signed, no scaling -> 123456
input.1.channel.3.offset = 0x04
input.1.channel.3.format = int_abcd
input.1.channel.3.topic  = t/energy
input.1.channel.3.value  = 123456

# 4-byte float -> 3.250
input.1.channel.4.offset = 0x08
input.1.channel.4.format = float_abcd
input.1.channel.4.topic  = t/temperature
input.1.channel.4.value  = 3.25

# top bit set, unsigned -> 65535 and not -1
input.1.channel.5.offset = 0x0C
input.1.channel.5.format = uint_ab
input.1.channel.5.topic  = t/flags
input.1.channel.5.value  = 65535

# add applies before scaling: (100 + 5) * 2 = 210
input.1.channel.6.offset = 0x0E
input.1.channel.6.format = uint_ab
input.1.channel.6.add    = 5
input.1.channel.6.mul    = 2
input.1.channel.6.topic  = t/scaled
input.1.channel.6.value  = 100

#
# 2. holding registers, the writable block
#
input.2.slave       = 1
input.2.type        = holding_register
input.2.address     = 0x0100
input.2.naddress    = 4
input.2.interval    = 200
input.2.channel.max = 1

input.2.channel.1.offset = 0x00
input.2.channel.1.format = uint_ab
input.2.channel.1.topic  = t/setpoint
input.2.channel.1.value  = 1234

#
# 3. coils -- naddress counts bits, channel.offset is a coil index
#
input.3.slave       = 1
input.3.type        = coil
input.3.address     = 0x0000
input.3.naddress    = 8
input.3.interval    = 200
input.3.channel.max = 3

input.3.channel.1.offset = 0
input.3.channel.1.topic  = t/coil_on
input.3.channel.1.value  = 1

input.3.channel.2.offset = 1
input.3.channel.2.topic  = t/coil_off
input.3.channel.2.value  = 0

input.3.channel.3.offset = 2
input.3.channel.3.topic  = t/coil_on2
input.3.channel.3.value  = 1

#
# 4. discrete inputs
#
input.4.slave       = 1
input.4.type        = discrete_input
input.4.address     = 0x0000
input.4.naddress    = 8
input.4.interval    = 200
input.4.channel.max = 2

input.4.channel.1.offset = 0
input.4.channel.1.topic  = t/di_on
input.4.channel.1.value  = 1

input.4.channel.2.offset = 3
input.4.channel.2.topic  = t/di_on3
input.4.channel.2.value  = 1

#
# 5. text channels -- serial numbers, versions and timestamps
#
# These never travel through the float path: modbusmq_server encodes each
# "value =" below into wire bytes with modbusmq_encode_text(), and test_read
# decodes them back with modbusmq_read_channel_text(). What is asserted is the
# round trip, so a byte-order mistake in either direction shows up as a
# mismatched string rather than as a number that happens to look plausible.
#
# The block is laid out byte by byte, and channel.length / channel.nregisters
# is what tells a variable-width format how far it reaches:
#
#    0-15  serial         16 bytes    42-45  date_ymd_abcd    4 bytes
#   16-23  model           8 bytes    46-57  datetime_regs   12 bytes
#   24-29  bcd_serial      6 bytes    58-61  epoch32_abcd     4 bytes
#   30-31  version_ab      2 bytes    62-65  epoch32_badc     4 bytes
#   32-35  version_abcd    4 bytes    66-69  epoch shifted    4 bytes
#   36-41  version_regs    6 bytes    70-73  epoch, timefmt   4 bytes
#
input.5.slave       = 1
input.5.type        = holding_register
input.5.address     = 0x0200
input.5.naddress    = 37
input.5.interval    = 200
input.5.channel.max = 12

# two characters per register, high byte first
input.5.channel.1.offset     = 0
input.5.channel.1.format     = ascii_ab
input.5.channel.1.nregisters = 8
input.5.channel.1.topic      = t/serial
input.5.channel.1.value      = PIX-00123456

# the same, with the two bytes of every register swapped. the interior space
# survives; only the NUL padding is dropped
input.5.channel.2.offset     = 16
input.5.channel.2.format     = ascii_ba
input.5.channel.2.nregisters = 4
input.5.channel.2.topic      = t/model
input.5.channel.2.value      = BOX 3

# packed BCD, two digits per byte. the leading zeros are part of the number
input.5.channel.3.offset     = 24
input.5.channel.3.format     = bcd_ab
input.5.channel.3.nregisters = 3
input.5.channel.3.topic      = t/bcd_serial
input.5.channel.3.value      = 001234567890

# one byte per field
input.5.channel.4.offset = 30
input.5.channel.4.format = version_ab
input.5.channel.4.topic  = t/fw_short
input.5.channel.4.value  = 2.7

input.5.channel.5.offset = 32
input.5.channel.5.format = version_abcd
input.5.channel.5.topic  = t/fw_long
input.5.channel.5.value  = 1.2.3.4

# one register per field, so a field may exceed 255
input.5.channel.6.offset     = 36
input.5.channel.6.format     = version_regs
input.5.channel.6.nregisters = 3
input.5.channel.6.topic      = t/fw_regs
input.5.channel.6.value      = 5.10.300

# uint16 year, then a byte each of month and day
input.5.channel.7.offset = 42
input.5.channel.7.format = date_ymd_abcd
input.5.channel.7.topic  = t/build_date
input.5.channel.7.value  = 2026-09-14

# six registers, one field each. no timezone is attached, so no trailing Z
input.5.channel.8.offset = 46
input.5.channel.8.format = datetime_regs
input.5.channel.8.topic  = t/device_clock
input.5.channel.8.value  = 2026-09-14T08:30:00

# epoch seconds -> ISO 8601 UTC
input.5.channel.9.offset = 58
input.5.channel.9.format = epoch32_abcd
input.5.channel.9.topic  = t/last_seen
input.5.channel.9.value  = 1757836800

# the same count with the two registers swapped
input.5.channel.10.offset = 62
input.5.channel.10.format = epoch32_badc
input.5.channel.10.topic  = t/last_seen_badc
input.5.channel.10.value  = 1757836800

# add is the epoch shift: a device counting from 2000-01-01 reads 0 here
input.5.channel.11.offset = 66
input.5.channel.11.format = epoch32_abcd
input.5.channel.11.add    = 946684800
input.5.channel.11.topic  = t/epoch2000
input.5.channel.11.value  = 0

# channel.timefmt overrides the ISO 8601 default
input.5.channel.12.offset  = 70
input.5.channel.12.format  = epoch32_abcd
input.5.channel.12.timefmt = %Y-%m-%d
input.5.channel.12.topic   = t/last_seen_date
input.5.channel.12.value   = 1757836800

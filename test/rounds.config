#
# rounds.config -- fixture for test_rounds
#
# bjornwennberg71@gmail.com
#
# Four slaves on one link, each with one fast input read every round and two
# deep inputs read only in the round that visits that slave. Served by the
# modbusmq_server run_tests.sh boots on test.config, which answers any slave:
# these addresses carry nothing there, so every register reads 0. Only the
# order of the requests matters here.
#
# Slave 3's second deep input asks for 126 registers, one over what Modbus
# allows, so the server answers it with an exception. That is the request
# that fails in every round visiting slave 3, to show a failure does not
# stall the round.
#

config.name    = rounds
config.version = 2.0

modbusmq.connect       = tcp://localhost:15502
modbusmq.frame_timeout_ms = 500

input.max            = 12
input.query_mode     = rounds
input.round_interval_ms = 0

# slave 1
input.1.slave       = 1
input.1.type        = input_register
input.1.address     = 0x0000
input.1.naddress    = 2
input.1.tier        = fast
input.1.channel.max = 1
input.1.channel.1.offset = 0
input.1.channel.1.format = uint_ab
input.1.channel.1.topic  = r/1/0000
input.2.slave       = 1
input.2.type        = input_register
input.2.address     = 0x0100
input.2.naddress    = 2
input.2.tier        = deep
input.2.channel.max = 1
input.2.channel.1.offset = 0
input.2.channel.1.format = uint_ab
input.2.channel.1.topic  = r/1/0100
input.3.slave       = 1
input.3.type        = input_register
input.3.address     = 0x0200
input.3.naddress    = 2
input.3.tier        = deep
input.3.channel.max = 1
input.3.channel.1.offset = 0
input.3.channel.1.format = uint_ab
input.3.channel.1.topic  = r/1/0200


#
# example2.config -- one real device over RTU: readings, a setpoint, alarms
#
# bjornwennberg71@gmail.com
#
# An aircon controller on slave 10: an input_register block of sensor
# readings, a holding_register block for its setpoint (read back and also
# written to from MQTT), and a discrete_input block for alarm bits. See
# config/CONFIG.md for the full key reference and config/example1.config
# for the bare minimum this builds on.
#

config.name    = example2
config.version = 2.0                  # int_* is signed, uint_* is unsigned

# --- Connection ---

modbusmq.connect = rtu:///dev/ttyUSB0:9600:1:8:N

modbusmq.rts_delay     = 10000        # 10ms: let the RS-485 bus settle before we transmit
modbusmq.frame_timeout = 1000         # give up on a response after 1s

# --- Inputs ---

input.max        = 3
input.query_mode = series            # all three blocks share this one RTU bus

# Sensor readings
input.1.slave       = 10
input.1.type        = input_register
input.1.address     = 0x0000
input.1.naddress    = 4
input.1.interval    = 2000
input.1.channel.max = 4

# Supply air temperature: raw is in tenths of a degree
input.1.channel.1.offset   = 0
input.1.channel.1.format   = uint_ab  # cannot go negative here, unlike ambient below
input.1.channel.1.mod      = -10
input.1.channel.1.decimals = 2        # match the two decimals the unit's own display shows
input.1.channel.1.topic    = aircon/supply_temperature
input.1.channel.1.value    = 215

# Ambient temperature: signed, can read below zero
input.1.channel.2.offset = 2
input.1.channel.2.format = int_ab
input.1.channel.2.mod    = -10
input.1.channel.2.topic  = aircon/ambient_temperature
input.1.channel.2.value  = -155

# Evaporator temperature: raw has a -40 offset baked in, tenths of a degree
input.1.channel.3.offset = 4
input.1.channel.3.format = int_ab
input.1.channel.3.add    = -400
input.1.channel.3.mod    = -10
input.1.channel.3.topic  = aircon/evaporator_temperature
input.1.channel.3.value  = 434

# Status word: no mod, so this prints as a whole number rather than "3.000"
input.1.channel.4.offset = 6
input.1.channel.4.format = uint_ab    # a status word must stay unsigned
input.1.channel.4.topic  = aircon/status
input.1.channel.4.value  = 3

# ---

# Setpoint, read back so we can see what the unit thinks it is set to
input.2.slave       = 10
input.2.type        = holding_register
input.2.address     = 0x0100
input.2.naddress    = 2
input.2.interval    = 5000
input.2.channel.max = 2

input.2.channel.1.offset = 0
input.2.channel.1.format = int_ab
input.2.channel.1.mod    = -10
input.2.channel.1.topic  = aircon/setpoint_temperature
input.2.channel.1.value  = 220

# Mode word: 0 = off, 1 = cool, 2 = heat
input.2.channel.2.offset = 2
input.2.channel.2.format = uint_ab
input.2.channel.2.topic  = aircon/mode
input.2.channel.2.value  = 1

# ---

# Alarm bits: these sit still for hours, so publishing every poll would
# just flood the broker with the same 0. Only publish on a flip, but
# heartbeat once an hour so a subscriber can tell the block is still alive.
input.3.slave        = 10
input.3.type         = discrete_input
input.3.address      = 0x0000
input.3.naddress     = 8
input.3.interval     = 2000
input.3.channel.max  = 3
input.3.on_change     = 1
input.3.max_interval  = 3600000

input.3.channel.1.offset = 0
input.3.channel.1.topic  = aircon/alarms/high_pressure
input.3.channel.1.value  = 0

# Safe to skip retain here: on_change/max_interval above already guarantee
# a subscriber sees this within the hour even without a retained message.
input.3.channel.2.offset = 1
input.3.channel.2.retain = 0
input.3.channel.2.topic  = aircon/alarms/door_open
input.3.channel.2.value  = 0

input.3.channel.3.offset = 2
input.3.channel.3.topic  = aircon/alarms/compressor_fault
input.3.channel.3.value  = 1

# --- Writes (MQTT to Modbus) ---

write.max = 1

# Mirrors input.2.channel.1: same register, same scaling, so a value
# published here reads back as the same number on aircon/setpoint_temperature.
write.1.name     = aircon_setpoint
write.1.slave    = 10
write.1.type     = holding_register
write.1.function = write_register
write.1.address  = 0x0100
write.1.format   = int_ab
write.1.mod      = -10
write.1.topic    = settings/aircon_setpoint_temperature

# --- MQTT ---

mqtt.name         = example2
mqtt.connect      = mqtt://localhost:1883
mqtt.topic_prefix = example2/
mqtt.retain       = 1                 # slow-moving state, default is right for most channels here
mqtt.qos          = 0

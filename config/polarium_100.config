config.name    = Polarium config
config.version = 0.1

# TCP
#modbusmq.connect = tcp://192.168.3.177
modbusmq.connect = tcp://localhost:1502

modbusmq.frame_timeout =  50000  # Default. Wait max 1s before giving up receiving a frame and discard it
modbusmq.rts_delay     = 10000  # 10 ms betweens writes to avoid losing frames (only for RTU)

mqtt.name    = polarium
mqtt.connect = mqtt://localhost:6660
mqtt.topic_prefix = polarium/battery/

# One input (request)
input.max = 99


#
# Murata batteries readout
#
# bjornwennberg71@gmail.com
#
#
config.name    = Murata config
config.version = 2.0

# RTU; the TCP alternative is tcp://192.168.3.177:502
modbusmq.connect = rtu:///dev/ttyUSB-RS485_3:115200:1:8:E

modbusmq.frame_timeout =  1000  # Default. Wait max 1s before giving up receiving a frame and discard it
modbusmq.rts_delay     = 10000  # 10 ms betweens writes to avoid losing frames (only for RTU)

# One input (request)
input.max = 1

input.1.slave          = 1
input.1.type           = input_register
input.1.address        = 0x0F
input.1.naddress       = 13           # 0x0F through 0x1B, the last channel below
input.1.interval       = 5000
input.1.channel.max    = 6

# Nominal Voltage mV, register 0x000F
input.1.channel.1.offset  = 0        # byte offset from 0x0F
input.1.channel.1.format  = uint_ab
input.1.channel.1.mod     = -1000
input.1.channel.1.topic   = voltage_nominal

# Rated Capacity mAh, register 0x0011
input.1.channel.2.offset  = 4
input.1.channel.2.format  = uint_ab
input.1.channel.2.mod     = -1000
input.1.channel.2.topic   = capacity_rated

# Max. Rated Voltage mV, register 0x0015
input.1.channel.3.offset  = 12
input.1.channel.3.format  = uint_ab
input.1.channel.3.mod     = -1000
input.1.channel.3.topic   = voltage_rated_max

# Min. Rated Voltage mV, register 0x0017
input.1.channel.4.offset  = 16
input.1.channel.4.format  = uint_ab
input.1.channel.4.mod     = -1000
input.1.channel.4.topic   = voltage_rated_min

# Max. Charge Current mA, register 0x0019
input.1.channel.5.offset  = 20
input.1.channel.5.format  = uint_ab
input.1.channel.5.mod     = -1000
input.1.channel.5.topic   = current_charge_max

# Max. Discharge Current mA, register 0x001B
input.1.channel.6.offset  = 24
input.1.channel.6.format  = uint_ab
input.1.channel.6.mod     = -1000
input.1.channel.6.topic   = current_discharge_max


mqtt.name    = murata_bms
mqtt.connect = mqtt://localhost:6660
mqtt.topic_prefix = murata/

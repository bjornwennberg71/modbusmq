#
# example4.config -- commissioning a device that is configured as a block,
# with acknowledgements back on MQTT
#
# bjornwennberg71@gmail.com
#
# The case this exists for: a smart fuse that will not be set up one register
# at a time. Rated current, trip curve, nominal voltage and the serial limit
# go in together or not at all, and the device answers a piecemeal attempt
# with an exception -- or, worse, accepts half of it.
#
# See config/CONFIG.md, "Block writes" and "Acknowledgements", for the full
# key reference.
#

config.name    = smart fuse commissioning
config.version = 2.0

modbusmq.connect       = tcp://192.168.1.50:502
modbusmq.frame_timeout = 2000

#
# Read the settings back, so the block that was written can be checked against
# what the device actually kept. A write ack says the device accepted the
# frame; only a read says what it stored.
#
input.max        = 1
input.query_mode = 0

input.1.slave       = 12
input.1.type        = holding_register
input.1.address     = 0x1000
input.1.naddress    = 5
input.1.interval    = 10000
input.1.channel.max = 4

input.1.channel.1.offset = 0
input.1.channel.1.format = uint_ab
input.1.channel.1.mod    = -10
input.1.channel.1.topic  = fuse1/rated_current

input.1.channel.2.offset = 2
input.1.channel.2.format = uint_ab
input.1.channel.2.topic  = fuse1/trip_curve

input.1.channel.3.offset = 4
input.1.channel.3.format = uint_ab
input.1.channel.3.topic  = fuse1/nominal_voltage

input.1.channel.4.offset = 6
input.1.channel.4.format = uint_abcd
input.1.channel.4.topic  = fuse1/serial_limit

mqtt.name         = fuse_commissioning
mqtt.connect      = mqtt://localhost:1883
mqtt.topic_prefix = plant/
mqtt.retain       = 1
mqtt.qos          = 1

#
# Acks for every write in this file. Each one lands on its write topic with
# "/ack" appended -- plant/settings/fuse1/ack below, since the prefix goes on
# first -- and is never retained.
#
mqtt.ack = 1

write.max = 2

#
# 1. The commissioning block: five registers in one function 16 frame.
#
# Every register from 0x1000 to 0x1004 belongs to a channel, because the block
# is written whole. Leave one out and modbusmq refuses the config at startup
# rather than sending a zero into it.
#
# offset is in BYTES from the start of the block, the same way an input
# channel counts them -- so the second register is offset 2, and channel 4's
# 4-byte format spans the last two registers on its own.
#
# Every channel carries a value, so publishing an empty payload to
# plant/settings/fuse1 writes exactly these numbers. That is the commissioning
# button: the settings live here, in version control, and nobody has to retype
# them into a broker at two in the morning.
#
write.1.name        = fuse1_settings
write.1.slave       = 12
write.1.type        = holding_register
write.1.address     = 0x1000
write.1.naddress    = 5
write.1.topic       = settings/fuse1
write.1.channel.max = 4

# rated current, tenths of an amp on the wire
write.1.channel.1.name   = rated_current
write.1.channel.1.offset = 0
write.1.channel.1.format = uint_ab
write.1.channel.1.mod    = -10
write.1.channel.1.value  = 63

# trip curve, an enumeration the device defines: 1 = B, 2 = C, 3 = D
write.1.channel.2.name   = trip_curve
write.1.channel.2.offset = 2
write.1.channel.2.format = uint_ab
write.1.channel.2.value  = 2

write.1.channel.3.name   = nominal_voltage
write.1.channel.3.offset = 4
write.1.channel.3.format = uint_ab
write.1.channel.3.value  = 230

# a 32-bit field, so it takes the two registers at 0x1003 and 0x1004
write.1.channel.4.name   = serial_limit
write.1.channel.4.offset = 6
write.1.channel.4.format = uint_abcd
write.1.channel.4.value  = 100000

#
# 2. A single setpoint, the shape every config before 2.5.0 used. Unchanged,
#    and it acks the same way.
#
write.2.name      = fuse1_trip_delay
write.2.slave     = 12
write.2.type      = holding_register
write.2.function  = write_register
write.2.address   = 0x1010
write.2.format    = uint_ab
write.2.mod       = -1000
write.2.topic     = settings/fuse1_trip_delay
write.2.ack_topic = settings/fuse1_trip_delay/result

#
# DBS air conditioner (RS485 / Modbus RTU)
#
# Cabinet door-mounted unit. Register map from Gen1 Monitoring/AirCon/DBS.
#
# Temperatures and voltages are raw x10, so mod = -10 throughout.
#
# Temperatures use int_ab (signed); everything that cannot go negative uses
# uint_ab. This file declares config.version 2.0, which is what gives int_ab
# its signed meaning - see CONFIG.md. Read unsigned, a sub-zero ambient would
# publish as roughly 6550 instead of -5.
#
# Whether the temperature registers really are two's-complement signed was
# never confirmed against DBS's own map - verify against the unit before
# relying on a negative reading operationally.
#

config.name    = DBS AirCon
config.version = 2.0

# Adjust the device path for whichever adapter is plugged in.
modbusmq.connect       = rtu:///dev/ttyUSB0:9600:1:8:N
modbusmq.frame_timeout = 1000

# 10 ms. Cheap auto-direction RS485 converters need the bus to settle before
# transmitting; raise this first if frames go missing.
modbusmq.rts_delay     = 10000

# One device on the bus, so parallel is fine. With more than one, use series.
input.query_mode = 0

input.max = 1

# --- Status block ---
input.1.slave       = 39
input.1.type        = input_register
input.1.address     = 0x0000
input.1.naddress    = 0x001F
input.1.interval    = 2000
input.1.channel.max = 9

# Indoor fan speed, RPM (register 0x0000)
input.1.channel.1.offset = 0
input.1.channel.1.format = uint_ab
input.1.channel.1.topic  = sensors/indoor_fan_speed

# Outdoor fan speed, RPM (register 0x0002)
input.1.channel.2.offset = 4
input.1.channel.2.format = uint_ab
input.1.channel.2.topic  = sensors/outdoor_fan_speed

# Indoor return-air temperature, degC (register 0x0004)
input.1.channel.3.offset = 8
input.1.channel.3.format = int_ab
input.1.channel.3.mod    = -10
input.1.channel.3.topic  = sensors/inlet_temperature

# Ambient/outdoor temperature, degC (register 0x0005)
input.1.channel.4.offset = 10
input.1.channel.4.format = int_ab
input.1.channel.4.mod    = -10
input.1.channel.4.topic  = sensors/ambient_temperature

# DC input voltage, V (register 0x0006)
input.1.channel.5.offset = 12
input.1.channel.5.format = uint_ab
input.1.channel.5.mod    = -10
input.1.channel.5.topic  = sensors/dc_input_voltage

# Compressor speed, DBS-only (register 0x0007)
input.1.channel.6.offset = 14
input.1.channel.6.format = uint_ab
input.1.channel.6.topic  = sensors/compressor_speed

# Condenser temperature, degC (register 0x000D)
input.1.channel.7.offset = 26
input.1.channel.7.format = int_ab
input.1.channel.7.mod    = -10
input.1.channel.7.topic  = sensors/condenser_temperature

# Return humidity, %RH (register 0x000E)
input.1.channel.8.offset = 28
input.1.channel.8.format = uint_ab
input.1.channel.8.mod    = -10
input.1.channel.8.topic  = sensors/return_humidity

# 'Cold end' temperature, degC (register 0x001E)
input.1.channel.9.offset = 60
input.1.channel.9.format = int_ab
input.1.channel.9.mod    = -10
input.1.channel.9.topic  = sensors/evaporator_temperature

#
# DBS alarms are discrete inputs (function 02). The config format now has a
# discrete_input type, so they can be added here as soon as the addresses are
# known - offset counts bits, not bytes:
#
#   input.2.slave       = 39
#   input.2.type        = discrete_input
#   input.2.address     = 0x0000
#   input.2.naddress    = 16
#   input.2.channel.1.offset = 0
#   input.2.channel.1.topic  = alarms/<name>
#

# ===================== WRITES =====================
#
# Every topic below is subscribed, never published. Publishing a value writes
# it to the register; publishing to a coil topic takes 1/0 or on/off.
#
write.max = 12

# Setpoints, degC x10
write.1.name     = compressor_on_temperature_setpoint
write.1.slave    = 39
write.1.type     = holding_register
write.1.function = write_register
write.1.address  = 0x0028
write.1.format   = int_ab
write.1.mod      = -10
write.1.topic    = settings/compressor_on_temperature_setpoint

write.2.name     = compressor_on_temperature_hysteresis
write.2.slave    = 39
write.2.type     = holding_register
write.2.function = write_register
write.2.address  = 0x0029
write.2.format   = int_ab
write.2.mod      = -10
write.2.topic    = settings/compressor_on_temperature_hysteresis

write.3.name     = heater_on_temperature_setpoint
write.3.slave    = 39
write.3.type     = holding_register
write.3.function = write_register
write.3.address  = 0x0016
write.3.format   = int_ab
write.3.mod      = -10
write.3.topic    = settings/heater_on_temperature_setpoint

write.4.name     = heater_on_temperature_hysteresis
write.4.slave    = 39
write.4.type     = holding_register
write.4.function = write_register
write.4.address  = 0x0017
write.4.format   = int_ab
write.4.mod      = -10
write.4.topic    = settings/heater_on_temperature_hysteresis

write.5.name     = high_temperature_alarm_setpoint
write.5.slave    = 39
write.5.type     = holding_register
write.5.function = write_register
write.5.address  = 0x001C
write.5.format   = int_ab
write.5.mod      = -10
write.5.topic    = settings/high_temperature_alarm_setpoint

write.6.name     = low_temperature_alarm_setpoint
write.6.slave    = 39
write.6.type     = holding_register
write.6.function = write_register
write.6.address  = 0x001D
write.6.format   = int_ab
write.6.mod      = -10
write.6.topic    = settings/low_temperature_alarm_setpoint

write.7.name     = dc_low_voltage_alarm_setpoint
write.7.slave    = 39
write.7.type     = holding_register
write.7.function = write_register
write.7.address  = 0x0027
write.7.format   = int_ab
write.7.mod      = -10
write.7.topic    = settings/dc_low_voltage_alarm_setpoint

# DBS-only below
write.8.name     = heat_exchanger_on_temperature_setpoint
write.8.slave    = 39
write.8.type     = holding_register
write.8.function = write_register
write.8.address  = 0x0038
write.8.format   = int_ab
write.8.mod      = -10
write.8.topic    = settings/heat_exchanger_on_temperature_setpoint

write.9.name     = heat_exchanger_on_temperature_hysteresis
write.9.slave    = 39
write.9.type     = holding_register
write.9.function = write_register
write.9.address  = 0x0039
write.9.format   = int_ab
write.9.mod      = -10
write.9.topic    = settings/heat_exchanger_on_temperature_hysteresis

write.10.name     = dehumidifier_on_humidity_setpoint
write.10.slave    = 39
write.10.type     = holding_register
write.10.function = write_register
write.10.address  = 0x0043
write.10.format   = int_ab
write.10.mod      = -10
write.10.topic    = settings/dehumidifier_on_humidity_setpoint

write.11.name     = dehumidifier_on_humidity_hysteresis
write.11.slave    = 39
write.11.type     = holding_register
write.11.function = write_register
write.11.address  = 0x0044
write.11.format   = int_ab
write.11.mod      = -10
write.11.topic    = settings/dehumidifier_on_humidity_hysteresis

# Unit power, a coil (function 05) - not a register write as on the Envicool models
write.12.name      = power_on_off
write.12.slave     = 39
write.12.type      = coil
write.12.function  = write_coil
write.12.address   = 0x000C
write.12.on_value  = 1
write.12.off_value = 0
write.12.topic     = commands/power_on_off

mqtt.name         = dbs_aircon
mqtt.connect      = mqtt://localhost:1883
mqtt.topic_prefix = cabinet/1/aircon/

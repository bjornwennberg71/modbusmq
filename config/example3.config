#
# example3.config -- fully fledged: two slaves, one bus, every input type,
# an address quirk worked around, and a full publish-rate-limiting policy
#
# bjornwennberg71@gmail.com
#
# Slave 1 is an energy meter, slave 2 a battery inverter, both on the same
# RS-485 line. See config/CONFIG.md for the full key reference and
# config/example2.config for a simpler single-device version of this.
#

config.name    = example3
config.version = 2.0                  # int_* is signed, uint_* is unsigned

# --- Connection ---

modbusmq.connect = rtu:///dev/ttyUSB0:9600:1:8:N

modbusmq.rts_delay     = 10000
modbusmq.frame_timeout = 1000

# --- Publish policy, config-wide default (bottom rung under input.N.* and
# input.N.channel.M.*, see "Publishing: decimals and rate limiting" in
# CONFIG.md). Nothing here should sit silent more than a minute, and
# nothing should spam more than once a second, without repeating both
# numbers on every input and channel below. ---

publish.max_interval = 60000
publish.min_interval = 1000

# --- Inputs ---

input.max        = 4

# Both slaves answer on the same physical pair, so simultaneous requests
# would collide on the wire; series staggers them instead of racing.
input.query_mode = series

# ==================================================================
# Slave 1: energy meter
# ==================================================================

# Voltage, current, power and energy in one request. Values here swing
# across a wide operating range, so a fixed min_change would be either
# too tight at low load or too loose at high load -- a percentage of the
# reading itself tracks that better.
input.1.slave          = 1
input.1.type           = input_register
input.1.address        = 0x0000
input.1.naddress       = 6
input.1.interval       = 1000
input.1.channel.max    = 4
input.1.min_change_rel = 0.001

# Voltage: raw is in tenths of a volt, and it never goes negative
input.1.channel.1.offset = 0
input.1.channel.1.format = uint_ab
input.1.channel.1.mod    = -10
input.1.channel.1.topic  = meter/voltage
input.1.channel.1.value  = 2300

# Current: the meter itself reports charge as negative, but our
# convention wants discharge (the common case) to read positive -- mul
# flips that without touching the raw scaling.
input.1.channel.2.offset = 2
input.1.channel.2.format = int_ab
input.1.channel.2.mod    = -10
input.1.channel.2.mul    = -1
input.1.channel.2.topic  = meter/current
input.1.channel.2.value  = -155

# Power: the device gives no hint of its own precision, so a float
# always publishes to three decimals regardless of scaling
input.1.channel.3.offset = 4
input.1.channel.3.format = float_abcd
input.1.channel.3.topic  = meter/power
input.1.channel.3.value  = 3450.5

# Energy counter: 32-bit and monotonically increasing, so unsigned
input.1.channel.4.offset = 8
input.1.channel.4.format = uint_abcd
input.1.channel.4.topic  = meter/energy_total
input.1.channel.4.value  = 128734

# ---

# Meter alarm bits: these sit still for most of a device's life, so
# publish only on a flip. Paired with max_interval so a subscriber that
# connects mid-stream still gets a value within the hour instead of
# seeing nothing until the next real change.
input.2.slave         = 1
input.2.type          = discrete_input
input.2.address       = 0x0010
input.2.naddress      = 8
input.2.interval      = 2000
input.2.channel.max   = 2
input.2.on_change     = 1
input.2.max_interval  = 3600000

input.2.channel.1.offset = 0
input.2.channel.1.topic  = meter/alarms/over_voltage
input.2.channel.1.value  = 0

# retain = 0 is safe here specifically because on_change/max_interval
# above already guarantee a fresh subscriber sees this within the hour --
# without that pairing a stale "no alarm" would look permanent instead.
input.2.channel.2.offset = 1
input.2.channel.2.retain = 0
input.2.channel.2.topic  = meter/alarms/under_voltage
input.2.channel.2.value  = 0

# ==================================================================
# Slave 2: battery inverter
# ==================================================================

# Register 0x2000 is reserved on this firmware and must not be read, so the
# request has to start one register later. address_offset does exactly that
# and nothing else: it is added to the address that goes out on the wire.
# The channel offsets below stay written as the datasheet documents them,
# in bytes from input.address; the library takes the shift back out when it
# decodes, so if a later firmware drops the quirk only this one line changes.
input.3.slave          = 2
input.3.type           = holding_register
input.3.address        = 0x2000
input.3.address_offset = 1              # request starts at 0x2001
input.3.naddress       = 2              # 0x2001 and 0x2002
input.3.interval       = 3000
input.3.channel.max    = 2

# Cell temperature: ignore jitter under half a degree between polls
input.3.channel.1.offset     = 2
input.3.channel.1.format     = int_ab
input.3.channel.1.mod        = -10
input.3.channel.1.min_change = 0.5
input.3.channel.1.topic      = inverter/temperature
input.3.channel.1.value      = 350

# Mode word: 0=idle, 1=discharging, 2=charging -- must stay unsigned
input.3.channel.2.offset = 4
input.3.channel.2.format = uint_ab
input.3.channel.2.topic  = inverter/mode
input.3.channel.2.value  = 2

# ---

# Contactor position: a status bit, not a jittery reading, so only
# publish when it actually changes. qos=1 because a stuck-closed
# contactor is exactly the kind of message worth a delivery guarantee.
input.4.slave         = 2
input.4.type          = coil
input.4.address       = 0x3000
input.4.naddress      = 2
input.4.interval      = 2000
input.4.channel.max   = 1
input.4.on_change     = 1
input.4.max_interval  = 3600000

input.4.channel.1.offset = 0
input.4.channel.1.qos    = 1
input.4.channel.1.topic  = inverter/contactor_closed
input.4.channel.1.value  = 1

# --- Writes (MQTT to Modbus) ---

write.max = 2

# Same coil input.4 reads back, so a command here is confirmed on
# inverter/contactor_closed once the device actually acts on it.
write.1.name      = inverter_contactor
write.1.slave     = 2
write.1.type      = coil
write.1.function  = write_coil
write.1.address   = 0x3000
write.1.on_value  = 1
write.1.off_value = 0
write.1.topic     = commands/inverter/contactor

# Charge current limit, tenths of an amp, in its own register.
write.2.name     = inverter_charge_current_limit
write.2.slave    = 2
write.2.type     = holding_register
write.2.function = write_register
write.2.address  = 0x2100
write.2.format   = int_ab
write.2.mod      = -10
write.2.topic    = settings/inverter/charge_current_limit

# --- MQTT ---

mqtt.name         = example3
mqtt.connect      = mqtt://localhost:1883
mqtt.topic_prefix = example3/
mqtt.retain       = 1
mqtt.qos          = 0

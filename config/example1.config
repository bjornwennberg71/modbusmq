#
# example1.config -- the smallest config that gets one number onto MQTT
#
# bjornwennberg71@gmail.com
#
# Read one register on one device, publish it to one topic. See
# config/CONFIG.md for every key and config/example2.config /
# config/example3.config for what a real deployment adds on top of this.
#

config.name    = example1
config.version = 2.0                  # int_* is signed, uint_* is unsigned

# --- Connection ---

modbusmq.connect = tcp://192.168.1.50:502

# --- Inputs ---

input.max = 1                         # one read request; must come before input.1.*

input.1.slave       = 1               # Modbus slave id
input.1.type        = input_register  # function 04, read-only registers
input.1.address     = 0               # first register to read
input.1.naddress    = 1               # read just the one register
input.1.interval    = 2000            # poll every 2s
input.1.channel.max = 1               # one channel; must come before channel.1.*

input.1.channel.1.offset = 0          # byte offset into the response
input.1.channel.1.format = uint_ab    # unsigned 16-bit, big-endian: cannot go negative
input.1.channel.1.topic  = voltage
input.1.channel.1.value  = 230        # default modbusmq_server serves for this channel

# --- MQTT ---

mqtt.name         = example1
mqtt.connect      = mqtt://localhost:1883
mqtt.topic_prefix = example1/

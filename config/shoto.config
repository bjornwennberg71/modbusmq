input.8.channel.8.offset  = 14
input.8.channel.8.format  = int_ab
input.8.channel.8.topic   = battery/module/8/fault_status

# State of Charge (SoC)
input.8.channel.9.offset  = 16
input.8.channel.9.format  = int_ab
input.8.channel.9.mod     = -100
input.8.channel.9.topic   = battery/module/8/soc

# State of Health (SoH)
input.8.channel.10.offset  = 18
input.8.channel.10.format  = int_ab
input.8.channel.10.mod     = -100
input.8.channel.10.topic   = battery/module/8/soh

# Full capacity (Ah)
input.8.channel.11.offset  = 20
input.8.channel.11.format  = int_ab
input.8.channel.11.mod     = -10
input.8.channel.11.topic   = battery/module/8/full_capacity

# Charge/discharge cycles
input.8.channel.12.offset  = 22
input.8.channel.12.format  = int_ab
input.8.channel.12.topic   = battery/module/8/cycle_count

# Number of cells
input.8.channel.13.offset  = 24
input.8.channel.13.format  = int_ab
input.8.channel.13.topic   = battery/module/8/num_cells

# Battery voltage
input.9.channel.1.offset  = 0
input.9.channel.1.format  = int_ab
input.9.channel.1.mod     = -100
input.9.channel.1.topic   = battery/module/9/voltage

# Current
input.9.channel.2.offset  = 2
input.9.channel.2.format  = int_ab
input.9.channel.2.mod     = -10
input.9.channel.2.mul     = -1
input.9.channel.2.add     = -10000
input.9.channel.2.topic   = battery/module/9/current

# Remaining capacity (Ah)
input.9.channel.3.offset  = 4
input.9.channel.3.format  = int_ab
input.9.channel.3.mod     = -10
input.9.channel.3.topic   = battery/module/9/remaining_capacity

# Average cell temperature
input.9.channel.4.offset  = 6
input.9.channel.4.format  = int_ab
input.9.channel.4.mod     = -10
input.9.channel.4.add     = -400
input.9.channel.4.topic   = battery/module/9/avg_cell_temp

# Environment temperature
input.9.channel.5.offset  = 8
input.9.channel.5.format  = int_ab
input.9.channel.5.mod     = -10
input.9.channel.5.add     = -400
input.9.channel.5.topic   = battery/module/9/env_temp

# Warning flag
input.9.channel.6.offset  = 10
input.9.channel.6.format  = int_ab
input.9.channel.6.topic   = battery/module/9/warning_flag

# Protection flag
input.9.channel.7.offset  = 12
input.9.channel.7.format  = int_ab
input.9.channel.7.topic   = battery/module/9/protection_flag

# Fault status
input.9.channel.8.offset  = 14
input.9.channel.8.format  = int_ab
input.9.channel.8.topic   = battery/module/9/fault_status

# State of Charge (SoC)
input.9.channel.9.offset  = 16
input.9.channel.9.format  = int_ab
input.9.channel.9.mod     = -100
input.9.channel.9.topic   = battery/module/9/soc

# State of Health (SoH)
input.9.channel.10.offset  = 18
input.9.channel.10.format  = int_ab
input.9.channel.10.mod     = -100
input.9.channel.10.topic   = battery/module/9/soh

# Full capacity (Ah)
input.9.channel.11.offset  = 20
input.9.channel.11.format  = int_ab
input.9.channel.11.mod     = -10
input.9.channel.11.topic   = battery/module/9/full_capacity

# Charge/discharge cycles
input.9.channel.12.offset  = 22
input.9.channel.12.format  = int_ab
input.9.channel.12.topic   = battery/module/9/cycle_count

# Number of cells
input.9.channel.13.offset  = 24
input.9.channel.13.format  = int_ab
input.9.channel.13.topic   = battery/module/9/num_cells





#
# example_rounds.config -- four battery packs on one RS-485 bus, polled in rounds
#
# bjornwennberg71@gmail.com
#
# The packs are identical, so each input is written once as a template
# (slave = module) and expanded into module.count copies, pack i
# (0..module.count-1) on slave module.slave_first + i, its topics under
# battery/<i>/ through %i. See
# "Module templates" in config/CONFIG.md. A site with 16 packs from slave 39
# runs the same file with -e module.count=16 -e module.slave_first=39.
#
# Each pack (packs 0..3 on slaves 1..4) has one small fast block -- pack voltage, current,
# state of charge -- that is read in every round, and two larger deep blocks
# -- the cell voltages and the cell temperatures -- that are read for one
# pack per round, round-robin. With 16 packs on 9600 baud that is the
# difference between fresh pack totals every ~1.5 s and every ~6.5 s; see
# "Round mode" in config/CONFIG.md for the arithmetic.
#
# A program can point modbusmq_set_focus() at one pack to read its deep
# blocks in every round as well, e.g. while a UI shows that pack;
# modbusmq_module_slave() maps the pack number to its slave.
#
# modbusmq_server serves the value = defaults, over TCP:
#
#   modbusmq_server -c example_rounds.config -e modbusmq.connect=tcp://localhost:1502
#

config.name    = example_rounds
config.version = 2.0

# --- Connection ---

modbusmq.connect       = rtu:///dev/ttyUSB0:9600:1:8:N
modbusmq.frame_timeout = 500          # ms; see "Setting frame_timeout for RTU"

# --- Packs ---

module.count       = 4                # packs in the rack
module.slave_first = 1                # slave id of pack 0

# --- Inputs ---

input.max            = 3              # per pack; 12 once expanded
input.query_mode     = rounds         # fast every round, deep one pack per round
input.round_interval = 1000           # at most one round a second; 0 = back to back

# --- every pack ---

# pack totals, every round
input.1.slave       = module
input.1.type        = input_register
input.1.address     = 0x0000
input.1.naddress    = 3
input.1.tier        = fast
input.1.channel.max = 3
input.1.channel.1.offset = 0
input.1.channel.1.format = uint_ab
input.1.channel.1.mod    = -100
input.1.channel.1.topic  = battery/%i/voltage
input.1.channel.1.value  = 5120
input.1.channel.2.offset = 2
input.1.channel.2.format = int_ab
input.1.channel.2.mod    = -10
input.1.channel.2.topic  = battery/%i/current
input.1.channel.2.value  = -125
input.1.channel.3.offset = 4
input.1.channel.3.format = uint_ab
input.1.channel.3.topic  = battery/%i/soc
input.1.channel.3.value  = 87

# cell voltages, when the round visits this pack (first 2 cells shown)
input.2.slave       = module
input.2.type        = input_register
input.2.address     = 0x0100
input.2.naddress    = 2
input.2.tier        = deep
input.2.channel.max = 2
input.2.channel.1.offset = 0
input.2.channel.1.format = uint_ab
input.2.channel.1.mod    = -1000
input.2.channel.1.topic  = battery/%i/cell/1/voltage
input.2.channel.1.value  = 3301
input.2.channel.2.offset = 2
input.2.channel.2.format = uint_ab
input.2.channel.2.mod    = -1000
input.2.channel.2.topic  = battery/%i/cell/2/voltage
input.2.channel.2.value  = 3298

# cell temperatures, when the round visits this pack
input.3.slave       = module
input.3.type        = input_register
input.3.address     = 0x0200
input.3.naddress    = 2
input.3.tier        = deep
input.3.channel.max = 2
input.3.channel.1.offset = 0
input.3.channel.1.format = int_ab
input.3.channel.1.mod    = -10
input.3.channel.1.topic  = battery/%i/cell/1/temperature
input.3.channel.1.value  = 231
input.3.channel.2.offset = 2
input.3.channel.2.format = int_ab
input.3.channel.2.mod    = -10
input.3.channel.2.topic  = battery/%i/cell/2/temperature
input.3.channel.2.value  = 229

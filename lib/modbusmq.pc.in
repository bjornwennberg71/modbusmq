prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: modbusmq
Description: Single-threaded, event-driven Modbus TCP/RTU library
URL: https://github.com/bjornwennberg71/modbusmq
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lmodbusmq
